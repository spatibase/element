{
  "name": "@element-editor/react",
  "version": "0.2.2",
  "description": "Drop-in React map editor: one component with drawing tools, vertex editing, snapping, a data table and a GeoJSON inspector, on MapLibre GL or Leaflet.",
  "keywords": [
    "element-editor",
    "react",
    "map-editor",
    "geojson",
    "geojson-editor",
    "maplibre",
    "leaflet",
    "drawing",
    "vertex-editing",
    "snapping",
    "gis"
  ],
  "homepage": "https://elementeditor.dev",
  "bugs": {
    "url": "https://github.com/spatibase/element/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spatibase/element.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Michal Acler",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/element-editor.cjs",
  "module": "./dist/element-editor.es.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "leaflet": [
        "./dist/leaflet.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "module": {
        "types": "./dist/index.d.ts",
        "default": "./dist/element-editor.es.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/element-editor.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/element-editor.cjs"
      }
    },
    "./leaflet": {
      "import": {
        "types": "./dist/leaflet.d.ts",
        "default": "./dist/leaflet.es.js"
      },
      "require": {
        "types": "./dist/leaflet.d.cts",
        "default": "./dist/leaflet.cjs"
      }
    },
    "./style.css": "./dist/element-editor.css",
    "./leaflet/style.css": "./dist/element-editor-leaflet.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/fix-dts.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "validate": "tsc -b && vitest run && playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@element-editor/adapter-maplibre": "workspace:*",
    "@element-editor/core": "workspace:*",
    "@element-editor/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@element-editor/adapter-leaflet": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^29.0.0",
    "leaflet": "^1.9.0",
    "maplibre-gl": "^6.18.0",
    "playwright": "^1.59.1",
    "react-data-grid": "7.0.0-beta.57",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@element-editor/adapter-leaflet": "workspace:^",
    "leaflet": "^1.9.0",
    "maplibre-gl": "^5.5.0 || ^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@element-editor/adapter-leaflet": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  }
}
