{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"],
    // Unit tests import sibling packages' sources, which are not built with these two flags.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/test", "e2e", "playwright.config.ts", "playwright.perf.config.ts"],
  "exclude": []
}
